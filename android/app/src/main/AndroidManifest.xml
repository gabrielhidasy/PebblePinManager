<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Opt-in network access used solely to fetch user-configured Remote Pin Feed JSON URLs.
        No network requests are made unless the user explicitly configures a remote feed.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Required on Android 13+ (API 33+) to show a high-priority tap-to-open notification when
        "Open Phone App" is triggered on the Pebble watch while PebblePinManager is in the background.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Optional: when explicitly granted by the user ("Display over other apps"), Android 10+
        exempts PebblePinManager from Background Activity Launch (BAL) restrictions so "Open Phone
        App" on the watch can open MainActivity immediately without tapping a notification.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        PebbleKit Android 2 client manifest automatically merges the
        io.rebble.pebblekit2.SEND_DATA_TO_WATCH <queries> entry so Android 11+
        package visibility can discover installed Core Devices Pebble / microPebble apps.
        Explicitly declared here as well for clarity and tooling visibility.
    -->
    <queries>
        <intent>
            <action android:name="io.rebble.pebblekit2.SEND_DATA_TO_WATCH" />
        </intent>
        <!-- Allow discovering user-installed launchable apps for the opt-in notification allowlist -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".PebblePinManagerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PebblePinManager"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".pebble.PebbleWatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="io.rebble.pebblekit2.RECEIVE_DATA_FROM_WATCH" />
            </intent-filter>
        </service>

        <service
            android:name=".notifications.PebbleNotificationListenerService"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
