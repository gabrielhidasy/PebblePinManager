<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        PebbleKit Android 2 client manifest automatically merges the
        io.rebble.pebblekit2.SEND_DATA_TO_WATCH <queries> entry so Android 11+
        package visibility can discover installed Core Devices Pebble / microPebble apps.
        Explicitly declared here as well for clarity and tooling visibility.
    -->
    <queries>
        <intent>
            <action android:name="io.rebble.pebblekit2.SEND_DATA_TO_WATCH" />
        </intent>
    </queries>

    <application
        android:name=".PebblePinManagerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PebblePinManager">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Reserved extension point for Issue #7 (NotificationListenerService):
            A NotificationListenerService declaring android.permission.BIND_NOTIFICATION_LISTENER_SERVICE
            will be registered here and route filtered notifications through
            xyz.hidasy.pebblepinmanager.notifications.NotificationPinPipeline -> TimelinePinSender.
        -->
    </application>

</manifest>
