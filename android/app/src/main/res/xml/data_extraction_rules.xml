<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
        Exclude optional Developer Mode raw notification logs (which may contain sensitive
        notifications from other apps such as 2FA codes or messages) from both Google Drive
        cloud backups and device-to-device transfers. All other app DataStores (such as
        sent_timeline_pins and user preferences) remain backed up normally.
    -->
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/raw_notifications_dev_log.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/raw_notifications_dev_log.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
