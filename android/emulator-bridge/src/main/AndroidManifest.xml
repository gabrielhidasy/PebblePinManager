<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".EmulatorBridgeApp"
        android:allowBackup="false"
        android:label="PebbleKit2 Emulator Bridge"
        android:usesCleartextTraffic="true">

        <!--
            Exposes connected emulated Pebble watches via the official PebbleKit Android 2
            ContentProvider contract (authority: <packageName>.pebblekit).
        -->
        <provider
            android:name=".EmulatorBridgeProvider"
            android:authorities="${applicationId}.pebblekit"
            android:exported="true" />

        <!--
            Implements the official PebbleKit Android 2 bound service endpoint so
            PebblePinManager's unmodified DefaultPebbleAndroidAppPicker and DefaultPebbleSender
            automatically discover and send timeline pins to the live Pebble QEMU emulator.
        -->
        <service
            android:name=".EmulatorBridgeSenderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.rebble.pebblekit2.SEND_DATA_TO_WATCH" />
            </intent-filter>
        </service>

        <!--
            Runtime configuration hook for E2E scripts via `adb shell am broadcast`.
        -->
        <receiver
            android:name=".BridgeConfigReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="xyz.hidasy.pebblepinmanager.emulatorbridge.CONFIGURE" />
            </intent-filter>
        </receiver>

        <!--
            Allows Emulator E2E scripts to post and cancel real high-priority Android notifications
            from a separate package so PebbleNotificationListenerService can be exercised end-to-end.
        -->
        <receiver
            android:name=".DemoNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="xyz.hidasy.pebblepinmanager.emulatorbridge.POST_NOTIFICATION" />
                <action android:name="xyz.hidasy.pebblepinmanager.emulatorbridge.CANCEL_NOTIFICATION" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
