# Copy to .env and replace with strong random tokens:
#   openssl rand -hex 32

# Host port on 127.0.0.1 exposed for your HTTPS reverse proxy
PIN_SERVER_PORT=8080

# Required: read-write token used by scripts/webhooks to create, update, and delete pins
PIN_SERVER_WRITE_TOKEN=replace-with-strong-random-write-token

# Optional (recommended): separate read-only token configured in the Android app
PIN_SERVER_READ_TOKEN=replace-with-strong-random-read-token

# How long past a pin's end time to keep it in the feed (default 48h; 0 disables auto-expiration)
PIN_SERVER_RETENTION=48h

# Set true when deployed behind a reverse proxy so access logs record X-Forwarded-For / X-Real-IP
PIN_SERVER_TRUST_PROXY=true

# Log verbosity: debug, info, warn, error
PIN_SERVER_LOG_LEVEL=info

# Temporary QR code pairing mode: set true to enable GET /register, then set back to false after pairing
PIN_SERVER_REGISTRATION_MODE=false

# Optional: public HTTPS base URL encoded in the /register QR code (auto-detected from request if empty)
# PIN_SERVER_PUBLIC_URL=https://pins.example.com

# Optional: friendly feed name pre-filled in the Android app when pairing via QR code
# PIN_SERVER_NAME=Home Pin Server
