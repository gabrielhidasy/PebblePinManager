FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV HOME=/root

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl \
      ca-certificates \
      git \
      build-essential \
      libc6-dev \
      libfreetype6 \
      libglib2.0-0 \
      nodejs \
      npm \
      xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv pebble-tool==5.2.0 \
    && mkdir -p /root/.config/pebble-sdk /root/.local/share/pebble-sdk \
    && printf 'n\n' | pebble sdk install latest

WORKDIR /work/watchapp
CMD ["pebble", "build"]
